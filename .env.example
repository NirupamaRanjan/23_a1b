# Manual (non-Docker) settings. Copy to .env in the repository root and edit:
#   cp .env.example .env            (Windows: Copy-Item .env.example .env)
# The API, bootstrap, seeders, fresh_pings.py and scripts/check-*.py read the root .env by
# themselves. Exported environment variables take priority over this file. Never commit .env.

# PostgreSQL used by the API and every Python tool. Use your existing database name (it does not
# have to be "careconnect"; "postgres" works too). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/careconnect

# Optional: the same server for the psql/createdb commands in the README
# (run "set -a; source .env; set +a" to export them into a bash/zsh terminal).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGDATABASE=careconnect

# MongoDB. The database name must stay medical_db (see docs/database_setup.md).
CARECONNECT_MONGO_URI=mongodb://localhost:27017/
CARECONNECT_MONGO_DB=medical_db

# Demo actor switching for this assignment (defaults to off in code). Keep cookies non-secure on
# plain http://localhost. Origins must match the address you open in the browser.
CARECONNECT_DEMO_MODE=true
CARECONNECT_COOKIE_SECURE=false
CARECONNECT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional: where the Vite dev server forwards /api (default http://127.0.0.1:8000).
# CARECONNECT_API_PROXY=http://127.0.0.1:8000

# Optional: the same generated names/data on every seeding run.
# CARECONNECT_SEED=2026

# Optional: API integration tests. The PostgreSQL database name must end in _test; the tests use
# the separate MongoDB database medical_db_test.
CARECONNECT_TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/careconnect_test
CARECONNECT_TEST_MONGO_URI=mongodb://localhost:27017/
