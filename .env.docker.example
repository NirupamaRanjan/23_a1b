# Docker Compose settings, separate from the manual .env. Copy once and keep it:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build --wait
# Host ports are bound to 127.0.0.1 only. The defaults avoid clashing with locally installed
# PostgreSQL (5432), MongoDB (27017) and a manually started API (8000).

# Password of the containerised PostgreSQL (used by the seed and api containers too).
POSTGRES_PASSWORD=postgres

POSTGRES_PORT=55432
MONGO_PORT=57017
API_PORT=8001
WEB_PORT=8080
